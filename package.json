{
  "name": "stattared4h",
  "version": "0.1.0",
  "private": true,
  "description": "Djurguide för Stättareds 4H-gård — ett komplement till 4h.se/stattared",
  "license": "MIT",
  "homepage": "https://stattared4h.github.io/stattared4h/",
  "repository": {
    "type": "git",
    "url": "https://github.com/stattared4h/stattared4h.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "eleventy",
    "start": "eleventy --serve --port 8080",
    "image": "node scripts/image.mjs",
    "image:import": "node scripts/image-import.mjs",
    "icons": "node scripts/icons.mjs",
    "qa:images": "node scripts/qa-images.mjs",
    "qa:prompts": "node scripts/qa-prompts.mjs",
    "qr": "node scripts/qr.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "lint": "npm run lint:css && npm run lint:ts && npm run lint:md && npm run lint:yaml && npm run lint:html && npm run lint:docs",
    "lint:css": "stylelint \"source/assets/css/**/*.css\"",
    "lint:ts": "eslint .",
    "lint:md": "markdownlint-cli2",
    "lint:yaml": "yamllint .",
    "lint:html": "html-validate \"public/**/*.html\"",
    "lint:docs": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "html-validate": "11.18.0",
    "markdown-it": "15.0.3",
    "markdownlint-cli2": "0.24.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  }
}
