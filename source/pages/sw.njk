---
permalink: sw.js
eleventyExcludeFromCollections: true
---
{#-
  The service worker (02-§7.3–7.9, 03-§5). The constants come from the build: the
  base path (ADR 0005), the cache name — base path plus version, "s4h-dev" when the
  build has no version (02-§7.6, 02-§10.26) — and the precache: every page in
  collections.all, the two pages kept out of the collections (offline, 404), and every
  file under source/assets/ (02-§7.4). The worker's code, source/ts/sw.ts, is bundled
  to the string `swCode` by eleventy.config.js and written after the constants.
-#}
/* Service worker for {{ site.name }}. Generated by the build; edit source/ts/sw.ts and source/pages/sw.njk. */
const BASE = {{ '/' | url | dump | safe }};
const CACHE_NAME = {{ (('/' | url) + (build.version or "s4h-dev")) | dump | safe }};
const PRECACHE = [
{%- for item in collections.all %}
{%- if item.url and item.url.endsWith("/") %}
  {{ item.url | url | dump | safe }},
{%- endif %}
{%- endfor %}
  {{ '/offline/' | url | dump | safe }},
  {{ '/404.html' | url | dump | safe }},
  {{ '/manifest.webmanifest' | url | dump | safe }},
  {{ '/assets/main.js' | url | dump | safe }},
{%- for asset in assets %}
  {{ ('/' + asset) | url | dump | safe }},
{%- endfor %}
];
{{ swCode | safe }}
