---
layout: base.njk
permalink: /karta/
title: Karta över gården
description: Karta över Stättareds 4H-gård med hagarna och vilka djurslag som går i var och en av dem.
---
{#-
  The map page (02-§5.23–5.27, 05-§6.31). The map markup comes rendered from
  source/ts/build/map.ts; the list under it is the full text alternative (02-§5.24).
#}
<div class="container container--narrow">
  <h1>Karta över gården</h1>

  {%- if views.map.html %}
  {{ views.map.html | safe }}
  {%- endif %}

  {%- if views.map.list.length > 0 %}
  <section class="page-section">
    <h2>Platserna</h2>
    <ul class="place-list">
      {%- for place in views.map.list %}
      <li class="place-list__item">
        <a class="place-list__link" href="{{ place.url | url }}">{{ place.name }}</a>
        {%- if place.species %}
        <span class="place-list__species">{{ place.species }}</span>
        {%- endif %}
      </li>
      {%- endfor %}
    </ul>
  </section>
  {%- else %}
  <p class="lead">Inga platser är inlagda ännu.</p>
  <p><a class="button" href="{{ '/' | url }}">Till startsidan</a></p>
  {%- endif %}

  {#- Maps of the area belong to the main site and to Naturkartan, not here (02-§5.34,
      02-§1.8). Ordinary links: nothing is embedded and nothing is fetched (02-§5.26). #}
  <section class="page-section">
    <h2>Fler kartor i området</h2>
    <ul class="place-list">
      {%- for map in site.areaMaps %}
      <li class="place-list__item">
        <a class="place-list__link" href="{{ map.url }}">{{ map.name }}</a>
        <span class="place-list__note">{{ map.about }}</span>
      </li>
      {%- endfor %}
    </ul>
  </section>
</div>
