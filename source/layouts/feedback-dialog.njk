{#
  The feedback dialog (02-§10.15–10.20, 05-§6.35, 05-§6.8). Markup only: the
  behaviour — opening, enabling "Skicka", building the issue address — is in
  source/ts/ui/feedback.ts, which reads the repository from `data-repo` so that no
  address is hard-coded in code. The hint under the fields explains why "Skicka" cannot
  be pressed yet (05-§6.12). The dialog has no padding of its own; a click that lands
  on the dialog element itself is therefore a click on the backdrop.
#}
<dialog class="dialog" data-feedback-dialog data-repo="{{ site.repo }}" aria-labelledby="feedback-heading">
  <form class="dialog__body" data-feedback-form>
    <div class="dialog__header">
      <h2 class="dialog__title" id="feedback-heading">Feedback om sajten</h2>
      <button class="icon-button dialog__close" type="button" aria-label="Stäng" data-feedback-close>
        <svg class="icon-button__icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
          <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <p>
      Här berättar du om något på den här sajten som är fel eller kan bli bättre.
      Frågor om gården – öppettider, boende, bokningar – hör till
      <a href="{{ site.mainSite }}">4h.se/stattared</a>.
    </p>
    <fieldset class="field field--choices">
      <legend class="field__label">Vad gäller det?</legend>
      <label class="choice"><input class="choice__input" type="radio" name="category" value="Fel" checked> Fel</label>
      <label class="choice"><input class="choice__input" type="radio" name="category" value="Förslag"> Förslag</label>
      <label class="choice"><input class="choice__input" type="radio" name="category" value="Övrigt"> Övrigt</label>
    </fieldset>
    <div class="field">
      <label class="field__label" for="feedback-title">Rubrik</label>
      <input class="field__input" id="feedback-title" name="title" type="text" maxlength="200" autocomplete="off">
    </div>
    <div class="field">
      <label class="field__label" for="feedback-body">Beskrivning</label>
      <textarea class="field__input field__input--multiline" id="feedback-body" name="body" rows="5" maxlength="2000"></textarea>
    </div>
    <p class="dialog__hint" data-feedback-hint aria-live="polite">Fyll i rubrik och beskrivning så går det att skicka.</p>
    <div class="dialog__actions">
      <button class="button" type="submit" data-feedback-submit disabled>Skicka</button>
    </div>
  </form>
</dialog>
