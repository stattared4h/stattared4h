{#
  Site header (02-§10.1–10.10, 02-§10.38–10.42, 05-§6.1). Markup only: the menu behaviour is in
  source/ts/ui/menu.ts; install, "to top" and feedback get theirs from their own modules,
  which find the buttons by their data attributes. Both layouts share one set of
  buttons and links; CSS decides what shows at which width (05-§5.4).
  Icons are inline SVG with aria-hidden (02-§10.32).
#}
{#- One entry per errand the site carries (02-§10.5), read by both the desktop row and
    the menu card. `children` makes the menu row a `<details>` (02-§10.43), with `all`
    naming the row that leads to the entry's own page; an entry without `children` is a
    plain link, which is why the map has none (02-§10.45). #}
{% set navLinks = [
  { href: "/", row: "Hem", menu: "Startsidan" },
  { href: "/karta/", row: "Kartan", menu: "Kartan" },
  { href: "/djuren/", row: "Djuren", menu: "Djuren", all: "Alla djuren", children: views.animalsOverview.species },
  { href: "/bingo/", row: "Bingo", menu: "Djurbingo" },
  { href: "/spana/", row: "Spana!", menu: "Spana!" },
  { href: "/om/", row: "Om sajten", menu: "Om sajten" }
] %}
<a class="skip-link" href="#main">Hoppa till innehållet</a>
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="{{ '/' | url }}">
      <img class="site-header__logo" src="{{ '/assets/img/4h-logo.svg' | url }}" alt="4H" width="64" height="44">
      <span class="site-header__name">{{ site.name }}</span>
    </a>

    {#- Both states live in the markup; `aria-expanded` decides which one shows, so the
        open/closed state is written in one place only (05-§6.42, 02-§10.4). #}
    <button class="icon-button icon-button--mobile-only site-header__menu-button" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-button>
      <svg class="icon-button__icon icon-button__icon--closed" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
        <path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <svg class="icon-button__icon icon-button__icon--open" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
        <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <span class="icon-button__label icon-button__label--closed">Meny</span>
      <span class="icon-button__label icon-button__label--open">Stäng</span>
    </button>

    {#- The way back (02-§10.40). A plain link to the start page, so it works without
        script and on a page opened straight from a QR code; source/ts/ui/back.ts swaps
        it for the history entry when the visitor came from a page of this site. The
        start page has none: there is nothing above it. #}
    {%- if page.url != "/" %}
    <a class="icon-button icon-button--mobile-only site-header__back" href="{{ '/' | url }}" aria-label="Tillbaka" data-back-button>
      <svg class="icon-button__icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
        <path d="M20 12H4m0 0 6-6m-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
    {%- endif %}

    <nav class="site-nav" aria-label="Huvudmeny">
      <ul class="site-nav__list">
        {%- for link in navLinks %}
        <li>
          <a class="site-nav__link" href="{{ link.href | url }}"{% if page.url == link.href %} aria-current="page"{% endif %}>{{ link.row }}</a>
        </li>
        {%- endfor %}
      </ul>
    </nav>

    <button class="icon-button icon-button--mobile-only site-header__to-top" type="button" aria-label="Till toppen" hidden data-to-top-button>
      <svg class="icon-button__icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
        <path d="M12 20V5m0 0-6 6m6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <button class="icon-button icon-button--plain-on-desktop site-header__install" type="button" aria-label="Installera appen" hidden data-install-button>
      <svg class="icon-button__icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
        <path d="M12 3v12m0 0-4-4m4 4 4-4M4 17v3h16v-3" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <button class="icon-button icon-button--plain-on-desktop site-header__feedback" type="button" aria-label="Ge feedback" data-feedback-button>
      <svg class="icon-button__icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
        <path d="M4 5h16v11H9l-5 4z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  {#- The overlay takes the press that falls outside the menu, so nothing under the card
      is activated by the press that closes it (02-§10.38). It sits after the row, which
      keeps its own stacking order, and before the card, which paints on top of it. #}
  <div class="site-menu-overlay" data-menu-overlay hidden></div>

  <nav class="site-menu" id="site-menu" aria-label="Meny">
    <a class="site-menu__brand" href="{{ '/' | url }}">
      <img class="site-menu__logo" src="{{ '/assets/img/4h-logo-white.svg' | url }}" alt="4H" width="58" height="40">
    </a>
    <ul class="site-menu__list">
      {%- for link in navLinks %}
      <li>
        {%- if link.children %}
        {#- The fold is `<details>`: no client code, keyboard and screen reader for free
            (02-§10.44). The chevron follows `[open]` in CSS (05-§6.46). #}
        <details class="site-menu__details">
          {#- The row inside carries the flex layout: a <summary> whose own `display` is
              changed stops toggling in some versions of Safari, and the browser's own
              open state is the whole point of the fold (02-§10.44). #}
          <summary class="site-menu__summary">
            <span class="site-menu__summary-row">
              <span class="site-menu__summary-label">{{ link.menu }}</span>
              <svg class="site-menu__chevron" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16">
                <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </summary>
          <ul class="site-menu__sublist">
            <li>
              <a class="site-menu__link site-menu__link--child" href="{{ link.href | url }}"{% if page.url == link.href %} aria-current="page"{% endif %}>{{ link.all }}</a>
            </li>
            {%- for child in link.children %}
            <li>
              <a class="site-menu__link site-menu__link--child" href="{{ child.url | url }}"{% if page.url == child.url %} aria-current="page"{% endif %}>{{ child.plural }}</a>
            </li>
            {%- endfor %}
          </ul>
        </details>
        {%- else %}
        <a class="site-menu__link" href="{{ link.href | url }}"{% if page.url == link.href %} aria-current="page"{% endif %}>{{ link.menu }}</a>
        {%- endif %}
      </li>
      {%- endfor %}
    </ul>
  </nav>
</header>
