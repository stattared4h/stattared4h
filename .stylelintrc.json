{
  "extends": [
    "stylelint-config-standard"
  ],
  "plugins": [
    "stylelint-declaration-strict-value"
  ],
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      [
        "/color$/",
        "fill",
        "stroke",
        "background",
        "background-color",
        "border-color",
        "outline",
        "outline-color",
        "box-shadow",
        "font-family",
        "font-size",
        "line-height",
        "border-radius",
        "margin",
        "margin-top",
        "margin-right",
        "margin-bottom",
        "margin-left",
        "margin-block",
        "margin-inline",
        "padding",
        "padding-top",
        "padding-right",
        "padding-bottom",
        "padding-left",
        "padding-block",
        "padding-inline",
        "gap",
        "row-gap",
        "column-gap"
      ],
      {
        "ignoreValues": [
          "inherit",
          "currentColor",
          "transparent",
          "none",
          "auto",
          "0",
          "initial",
          "unset",
          "normal",
          "/^calc\\(/",
          "/^env\\(/",
          "/^-?[0-9.]+(%|ch|em|rem|vw|vh|fr)$/",
          "/^(-?[0-9.]+(%|ch|em|vw|vh|fr)?\\s+)+/"
        ]
      }
    ],
    "declaration-no-important": true,
    "selector-class-pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
    "custom-property-empty-line-before": null,
    "comment-empty-line-before": null,
    "property-no-vendor-prefix": null,
    "color-hex-length": "long",
    "media-feature-range-notation": "prefix"
  },
  "overrides": [
    {
      "files": [
        "source/assets/css/tokens.css"
      ],
      "rules": {
        "scale-unlimited/declaration-strict-value": null,
        "alpha-value-notation": null
      }
    }
  ],
  "ignoreFiles": [
    "public/**",
    "node_modules/**"
  ]
}
